server {
    listen 80;
    server_name _;

    location /static/ {
        alias /var/www/fruitkha-assets/;
        autoindex on;
    }

    location /media/ {
        alias /var/www/fruitkha-media/;
        autoindex on;
    }

    location / {
        proxy_pass http://web:8000;  # Pass to the 'web' service in docker-compose
        proxy_set_header Host $host;
        # Use CF-Connecting-IP from Cloudflare for the real IP
        proxy_set_header X-Real-IP $http_cf_connecting_ip;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}